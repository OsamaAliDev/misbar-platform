# Phase 5A: copy to .env (git ignored). Do not commit actual values.
# No VITE_ secrets: all Supabase requests terminate on the Node server.
# Leave BOTH values empty for the explicitly labeled local mock.
# Supplying only one value fails closed; Supabase errors NEVER fallback to mock.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Production listener; development API uses API_PORT=3002 via pnpm dev:api.
PORT=3000
# For a trusted reverse proxy, set the actual public origin (no path), if needed.
APP_ORIGIN=

# Required only for intentionally running synthetic mock mode in production.
# NEVER use the mock as a school production database.
ALLOW_MOCK=false

# Before real Supabase operation:
# 1. Apply supabase/migrations/20261116_saas_foundation.sql in SQL Editor.
# 2. Enable anonymous sign-ins for students (no email/phone).
# 3. Create staff accounts with verified email/password in Supabase Auth.
# 4. Bootstrap staff Auth UUIDs and school roles using the documented trusted SQL.
# Subscription management/gating is deferred; subscriptions is schema only.
# Use a nonproduction Supabase project for the write-based RLS proof.
# No service-role key is required. Never put one in VITE_.
