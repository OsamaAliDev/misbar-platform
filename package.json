{
  "name": "misbar-platform",
  "private": true,
  "version": "0.1.0",
  "description": "مِسبار (Misbar) — Arabic RTL interactive science & math experiments platform for students aged 10–14.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "API_PORT=3002 node --env-file-if-exists=.env server/index.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test:saas": "node --test server/test*.mjs",
    "test:rls": "bash supabase/tests/run-rls-proof.sh"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
